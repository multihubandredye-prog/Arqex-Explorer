<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_vertical"
    android:layout_gravity="bottom|center"
    android:orientation="horizontal"
    android:id="@id/find_layout"
    android:background="#b3000000"
    android:visibility="gone"
    android:layout_width="200.0dip"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/size_60"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/find_close"
        android:tag="@string/back"
        android:layout_width="@dimen/bar_button_width"
        android:layout_height="@dimen/bar_button_width"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true" />
    <EditText
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:id="@id/find_box"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@id/find_next"
        android:layout_toRightOf="@id/find_close"
        android:inputType="textFilter"
        android:layout_toStartOf="@id/find_next"
        android:layout_toEndOf="@id/find_close"
        style="@style/EditText.WidgetEditText" />
    <ImageView
        android:id="@id/find_prev"
        android:layout_width="@dimen/bar_button_width"
        android:layout_height="@dimen/bar_button_width"
        android:text="@string/previous"
        android:layout_toLeftOf="@id/find_next"
        android:layout_toStartOf="@id/find_next" />
    <ImageView
        android:id="@id/find_next"
        android:layout_width="@dimen/bar_button_width"
        android:layout_height="@dimen/bar_button_width"
        android:text="@string/next"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true" />
</RelativeLayout>