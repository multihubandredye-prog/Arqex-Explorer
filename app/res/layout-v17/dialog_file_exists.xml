<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/dialog_header" />
    <LinearLayout
        android:id="@id/body_view"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.mixplorer.widgets.MiScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/size_5"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/founded"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:padding="@dimen/size_2"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        android:layout_marginBottom="@dimen/size_5">
                        <ImageView
                            android:id="@id/icon_found"
                            android:layout_width="@dimen/medium_thumb"
                            android:layout_height="@dimen/medium_thumb"
                            android:layout_marginRight="@dimen/size_5"
                            android:layout_marginEnd="@dimen/size_5" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/primary_text_size"
                                android:textStyle="bold"
                                android:ellipsize="start"
                                android:id="@id/name_found"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:singleLine="true" />
                            <TextView
                                android:textSize="@dimen/medium_text_size"
                                android:ellipsize="start"
                                android:id="@id/path_found"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:singleLine="true" />
                            <TextView
                                android:textSize="@dimen/secondary_text_size"
                                android:id="@id/info_found"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:tag="line"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/size_1" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/overwrite"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textStyle="bold"
                        android:id="@id/overwrite_descr"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginTop="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        style="@style/DialogLeft" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="@dimen/size_2"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        android:layout_marginBottom="@dimen/size_5">
                        <TextView
                            android:textSize="@dimen/medium_text_size"
                            android:id="@id/path_overwrite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="false" />
                        <TextView
                            android:textSize="@dimen/secondary_text_size"
                            android:id="@id/info_overwrite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="2" />
                        <CheckBox
                            android:id="@id/ch_overwrite"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_10"
                            android:layout_marginBottom="@dimen/size_5"
                            style="@style/WidgetCompoundButton.CheckBox" />
                    </LinearLayout>
                    <View
                        android:tag="line"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/size_1" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/resume"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textStyle="bold"
                        android:id="@id/resume_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginTop="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        style="@style/DialogLeft" />
                    <TextView
                        android:textSize="@dimen/medium_text_size"
                        android:id="@id/resume_desc_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        android:layout_marginBottom="@dimen/size_5" />
                    <View
                        android:tag="line"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/size_1" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/skip"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textStyle="bold"
                        android:id="@id/skip_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginTop="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        style="@style/DialogLeft" />
                    <TextView
                        android:textSize="@dimen/medium_text_size"
                        android:id="@id/skip_desc_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        android:layout_marginBottom="@dimen/size_5" />
                    <View
                        android:tag="line"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/size_1" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/keep_both"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textStyle="bold"
                        android:id="@id/keep_both_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginTop="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        style="@style/DialogLeft" />
                    <TextView
                        android:textSize="@dimen/medium_text_size"
                        android:id="@id/keep_both_desc_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        android:layout_marginBottom="@dimen/size_5" />
                    <View
                        android:tag="line"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/size_1" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/new_name"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textStyle="bold"
                        android:id="@id/new_name_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginTop="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        style="@style/DialogLeft" />
                    <TextView
                        android:textSize="@dimen/medium_text_size"
                        android:id="@id/new_name_desc_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginRight="@dimen/size_5"
                        android:layout_marginBottom="@dimen/size_5" />
                    <View
                        android:tag="line"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/size_1" />
                </LinearLayout>
                <CheckBox
                    android:id="@id/remember"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    android:layout_marginBottom="@dimen/size_5"
                    style="@style/WidgetCompoundButton.CheckBox" />
            </LinearLayout>
        </com.mixplorer.widgets.MiScrollView>
    </LinearLayout>
    <include
        layout="@layout/dialog_footer" />
</LinearLayout>