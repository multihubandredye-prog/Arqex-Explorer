<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/dialog_header" />
    <LinearLayout
        android:id="@id/body_view"
        android:paddingLeft="@dimen/size_10"
        android:paddingRight="@dimen/size_10"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.mixplorer.widgets.MiScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/size_5"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/archive_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_10"
                    android:inputType="textCapWords"
                    style="@style/EditText.WidgetEditText" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/archive_format"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        style="@style/WidgetSpinner" />
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/archive_method"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_10"
                        android:layout_weight="1.0"
                        android:layout_marginStart="@dimen/size_10"
                        style="@style/WidgetSpinner" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/archive_level"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        style="@style/WidgetSpinner" />
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/archive_encryption"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_10"
                        android:layout_weight="1.0"
                        android:layout_marginStart="@dimen/size_10"
                        style="@style/WidgetSpinner" />
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <TextView
                        android:id="@id/archive_dict_size_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/DialogLeft" />
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/archive_dict_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_10"
                        android:layout_marginStart="@dimen/size_10"
                        style="@style/WidgetSpinner" />
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <TextView
                        android:id="@id/archive_word_size_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/DialogLeft" />
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/archive_word_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_10"
                        android:layout_marginStart="@dimen/size_10"
                        style="@style/WidgetSpinner" />
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <TextView
                        android:id="@id/archive_block_size_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/DialogLeft" />
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/archive_solid_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_10"
                        android:layout_marginStart="@dimen/size_10"
                        style="@style/WidgetSpinner" />
                </LinearLayout>
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/archive_key"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_5"
                    android:layout_marginBottom="@dimen/size_2"
                    android:inputType="textPassword"
                    style="@style/EditText.WidgetEditText" />
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/archive_key_reenter"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    style="@style/EditText.WidgetEditText" />
                <CheckBox
                    android:id="@id/remember"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_10"
                    android:checked="false"
                    style="@style/WidgetCompoundButton.CheckBox" />
                <CheckBox
                    android:id="@id/separately"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    style="@style/WidgetCompoundButton.CheckBox" />
                <CheckBox
                    android:id="@id/delete_source"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    style="@style/WidgetCompoundButton.CheckBox" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_5"
                    android:baselineAligned="false">
                    <com.mixplorer.widgets.MiEditText
                        android:id="@id/archive_split_length"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:inputType="number"
                        style="@style/EditText.WidgetEditText" />
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/archive_split_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_10"
                        android:layout_marginTop="@dimen/size_5"
                        android:layout_marginStart="@dimen/size_10"
                        style="@style/WidgetSpinner" />
                </LinearLayout>
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/archive_comment"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_10"
                    android:inputType="textCapSentences|textMultiLine"
                    style="@style/EditText.WidgetEditText" />
                <CheckBox
                    android:id="@id/archive_encrypt_filenames"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    style="@style/WidgetCompoundButton.CheckBox" />
            </LinearLayout>
        </com.mixplorer.widgets.MiScrollView>
    </LinearLayout>
    <include
        layout="@layout/dialog_footer" />
</LinearLayout>