<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/content"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/notification_icon"
        android:background="@android:color/transparent"
        android:layout_width="@dimen/ntf_expanded_thumb"
        android:layout_height="@dimen/ntf_expanded_thumb"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true" />
    <ImageButton
        android:id="@id/notification_stop"
        android:background="#00000000"
        android:paddingLeft="0.0dip"
        android:paddingRight="@dimen/size_10"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/size_30"
        android:layout_height="@dimen/size_30"
        android:layout_margin="@dimen/size_5"
        android:scaleType="centerInside"
        android:layout_alignParentRight="true"
        android:paddingStart="0.0dip"
        android:paddingEnd="@dimen/size_10"
        android:layout_alignParentEnd="true" />
    <TextView
        android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent.Title"
        android:gravity="center_vertical"
        android:id="@id/notification_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_10"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginRight="@dimen/size_10"
        android:maxLines="2"
        android:layout_toLeftOf="@id/notification_stop"
        android:layout_toRightOf="@id/notification_icon"
        android:layout_toStartOf="@id/notification_stop"
        android:layout_toEndOf="@id/notification_icon" />
    <TextView
        android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent"
        android:gravity="top"
        android:id="@id/notification_descr"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_10"
        android:layout_marginTop="@dimen/size_10"
        android:maxLines="2"
        android:layout_toRightOf="@id/notification_icon"
        android:layout_below="@id/notification_title"
        android:layout_marginStart="@dimen/size_10"
        android:layout_toEndOf="@id/notification_icon" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_40"
        android:layout_toRightOf="@id/notification_icon"
        android:layout_alignBottom="@id/notification_icon"
        android:layout_alignParentRight="true"
        android:layout_toEndOf="@id/notification_icon"
        android:layout_alignParentEnd="true">
        <ImageButton
            android:id="@id/notification_prev"
            android:background="#00000000"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/size_10"
            android:scaleType="centerInside"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/size_10" />
        <ImageButton
            android:id="@id/notification_pause_resume"
            android:background="#00000000"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/size_15"
            android:layout_marginRight="@dimen/size_15"
            android:scaleType="centerInside"
            android:layout_weight="1.0" />
        <ImageButton
            android:id="@id/notification_next"
            android:background="#00000000"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginRight="@dimen/size_10"
            android:scaleType="centerInside"
            android:layout_weight="1.0"
            android:layout_marginEnd="@dimen/size_10" />
    </LinearLayout>
</RelativeLayout>