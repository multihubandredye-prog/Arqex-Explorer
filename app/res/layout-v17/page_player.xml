<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_gravity="bottom|center"
    android:id="@id/content1"
    android:background="@android:color/black"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/album_art"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop" />
    <FrameLayout
        android:id="@id/blur_panel"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <FrameLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@id/player_holder"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:longClickable="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center|left"
        android:orientation="vertical"
        android:id="@id/brightness_panel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_10">
        <ImageView
            android:id="@id/brightness_icon"
            android:layout_width="@dimen/size_40"
            android:layout_height="@dimen/size_40"
            android:scaleType="centerInside" />
        <com.mixplorer.widgets.MiVerticalSeekBar
            android:layout_gravity="center_horizontal"
            android:id="@id/brightness_bar"
            android:focusable="true"
            android:nextFocusDown="@id/btn_backward"
            android:layout_width="@dimen/size_10"
            android:layout_height="@dimen/find_bar_min_width" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center|right"
        android:orientation="vertical"
        android:id="@id/volume_panel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/size_10">
        <ImageView
            android:id="@id/volume_icon"
            android:layout_width="@dimen/size_40"
            android:layout_height="@dimen/size_40"
            android:scaleType="centerInside" />
        <com.mixplorer.widgets.MiVerticalSeekBar
            android:layout_gravity="center_horizontal"
            android:id="@id/volume_bar"
            android:focusable="true"
            android:nextFocusDown="@id/btn_forward"
            android:layout_width="@dimen/size_10"
            android:layout_height="@dimen/find_bar_min_width" />
    </LinearLayout>
    <ScrollView
        android:layout_gravity="center"
        android:id="@id/lyrics_panel"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginLeft="@dimen/size_40"
        android:layout_marginTop="100.0dip"
        android:layout_marginRight="@dimen/size_40"
        android:layout_marginBottom="160.0dip"
        android:fillViewport="true"
        android:layout_marginStart="@dimen/size_40"
        android:layout_marginEnd="@dimen/size_40">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@id/lyrics_box"
            android:padding="0.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/size_2" />
    </ScrollView>
    <TextView
        android:textStyle="bold"
        android:gravity="bottom|center"
        android:layout_gravity="bottom|center"
        android:id="@id/subtitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_30"
        android:layout_marginRight="@dimen/size_30"
        android:layout_marginBottom="@dimen/size_10" />
    <RelativeLayout
        android:id="@id/controller"
        android:fitsSystemWindows="true"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.mixplorer.widgets.MiToggleView
            android:id="@id/toggle"
            android:tag="@string/back"
            android:nextFocusDown="@id/brightness_bar"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="@dimen/bar_button_width"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="@dimen/size_5"
            android:paddingRight="@dimen/size_5"
            android:clickable="true"
            android:longClickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toggle_width"
            android:layout_toLeftOf="@id/btn_hw"
            android:layout_toRightOf="@id/toggle"
            android:layout_alignParentTop="true">
            <TextView
                android:ellipsize="end"
                android:id="@id/bar_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_3"
                android:layout_marginBottom="@dimen/size_2"
                android:maxLines="1"
                android:singleLine="true" />
            <TextView
                android:ellipsize="end"
                android:id="@id/bar_details"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true" />
        </LinearLayout>
        <com.mixplorer.widgets.MiImageView
            android:id="@id/btn_hw"
            android:tag="HW/SW"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="@dimen/bar_button_width"
            android:layout_toLeftOf="@id/overflow" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/overflow"
            android:tag="@string/menu"
            android:nextFocusDown="@id/volume_bar"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="@dimen/bar_button_width"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/buttons"
            android:padding="@dimen/size_3"
            android:longClickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0.0dip"
            android:layout_above="@id/btn_speed"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <com.mixplorer.widgets.MiImageView
                android:layout_gravity="center"
                android:id="@id/btn_backward"
                android:tag="@string/backward"
                android:layout_width="@dimen/size_35"
                android:layout_height="@dimen/size_35"
                android:scaleType="centerInside" />
            <com.mixplorer.widgets.MiImageView
                android:layout_gravity="center"
                android:id="@id/btn_previous"
                android:tag="@string/previous"
                android:layout_width="@dimen/size_40"
                android:layout_height="@dimen/size_40"
                android:layout_marginLeft="@dimen/size_10"
                android:layout_marginRight="@dimen/size_3"
                android:scaleType="centerInside" />
            <com.mixplorer.widgets.MiPlayPauseView
                android:layout_gravity="center"
                android:id="@id/btn_toggle"
                android:tag="@string/play"
                android:focusable="true"
                android:layout_width="@dimen/size_60"
                android:layout_height="@dimen/size_60"
                android:layout_marginLeft="@dimen/size_25"
                android:layout_marginRight="@dimen/size_25" />
            <com.mixplorer.widgets.MiImageView
                android:layout_gravity="center"
                android:id="@id/btn_next"
                android:tag="@string/next"
                android:layout_width="@dimen/size_40"
                android:layout_height="@dimen/size_40"
                android:layout_marginLeft="@dimen/size_3"
                android:layout_marginRight="@dimen/size_10"
                android:scaleType="centerInside" />
            <com.mixplorer.widgets.MiImageView
                android:layout_gravity="center"
                android:id="@id/btn_forward"
                android:tag="@string/forward"
                android:layout_width="@dimen/size_35"
                android:layout_height="@dimen/size_35"
                android:scaleType="centerInside" />
        </LinearLayout>
        <com.mixplorer.widgets.MiImageView
            android:id="@id/btn_speed"
            android:tag="@string/speed"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="@dimen/bar_button_width"
            android:layout_margin="@dimen/size_5"
            android:scaleType="centerInside"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/btn_loop"
            android:tag="@string/loop"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="@dimen/bar_button_width"
            android:layout_margin="@dimen/size_5"
            android:scaleType="centerInside"
            android:layout_above="@id/btn_speed"
            android:layout_alignParentLeft="true" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/seek_bar_parent"
            android:paddingTop="@dimen/size_5"
            android:paddingBottom="@dimen/size_10"
            android:clickable="true"
            android:longClickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0.0dip"
            android:layout_toLeftOf="@id/btn_fit_screen"
            android:layout_toRightOf="@id/btn_speed"
            android:layout_alignParentBottom="true">
            <com.mixplorer.widgets.MiSeekBar
                android:id="@id/seek_bar"
                android:paddingLeft="@dimen/size_10"
                android:paddingRight="@dimen/size_10"
                android:focusable="true"
                android:clickable="true"
                android:longClickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
            <FrameLayout
                android:paddingLeft="@dimen/size_10"
                android:paddingRight="@dimen/size_10"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="left"
                    android:id="@id/player_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_gravity="right"
                    android:id="@id/player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>
        </LinearLayout>
        <com.mixplorer.widgets.MiImageView
            android:id="@id/btn_shuffled"
            android:tag="@string/random"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="@dimen/bar_button_width"
            android:layout_margin="@dimen/size_5"
            android:scaleType="centerInside"
            android:layout_above="@id/btn_fit_screen"
            android:layout_alignParentRight="true" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/btn_fit_screen"
            android:tag="@string/random"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="@dimen/bar_button_width"
            android:layout_margin="@dimen/size_5"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>
</FrameLayout>