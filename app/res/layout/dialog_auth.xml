<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/dialog_header" />
    <LinearLayout
        android:id="@id/body_view"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.mixplorer.widgets.MiScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/size_5"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/auth_form"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.mixplorer.widgets.MiEditText
                        android:id="@id/username"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/size_5"
                        android:selectAllOnFocus="true"
                        android:inputType="textEmailAddress|textNoSuggestions"
                        style="@style/EditText.WidgetEditText" />
                    <com.mixplorer.widgets.MiEditText
                        android:id="@id/password"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_5"
                        android:layout_marginBottom="@dimen/size_5"
                        android:inputType="textNoSuggestions|textPassword"
                        style="@style/EditText.WidgetEditText" />
                    <TextView
                        android:textSize="@dimen/button_text_size"
                        android:textColor="#ffff0000"
                        android:id="@id/txt_error"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_10" />
                </LinearLayout>
                <com.mixplorer.widgets.MiCircleView
                    android:id="@id/auth_progress"
                    android:visibility="gone"
                    style="@style/ProgressBar" />
            </LinearLayout>
        </com.mixplorer.widgets.MiScrollView>
    </LinearLayout>
    <include
        layout="@layout/dialog_footer" />
</LinearLayout>