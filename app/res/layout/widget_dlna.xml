<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:background="@color/widget_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/widget_dlna_toggle"
        android:padding="@dimen/appwidget_padding"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@drawable/icon_widget_bg"
        android:layout_centerHorizontal="true" />
    <ImageView
        android:id="@id/widget_dlna_switch"
        android:padding="@dimen/appwidget_padding"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@drawable/icon_widget_server_off"
        android:layout_centerHorizontal="true" />
    <TextView
        android:textSize="@dimen/appwidget_text_size"
        android:textColor="#ffffffff"
        android:id="@id/widget_dlna_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appwidget_padding"
        android:text="DLNA"
        android:maxLines="1"
        android:singleLine="true"
        android:shadowColor="@android:color/black"
        android:shadowDy="2.0"
        android:shadowRadius="2.0"
        android:layout_alignBottom="@id/widget_dlna_toggle"
        android:layout_centerHorizontal="true" />
</RelativeLayout>