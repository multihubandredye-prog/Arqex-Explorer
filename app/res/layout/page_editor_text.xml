<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/content1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/top_bar"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.mixplorer.widgets.MiToggleView
            android:id="@id/toggle"
            android:tag="@string/exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.mixplorer.widgets.MiSpinner
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/navigation"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/title"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:maxLines="2" />
        </com.mixplorer.widgets.MiSpinner>
        <com.mixplorer.widgets.MiImageView
            android:id="@id/undo"
            android:tag="@string/undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/redo"
            android:tag="@string/redo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/save"
            android:tag="@string/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/overflow"
            android:tag="@string/menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <com.mixplorer.widgets.MiViewPager
        android:layout_gravity="fill"
        android:id="@id/main_page"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/status_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/bar_height_status">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/status"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/editor_modes"
            android:tag="@string/view"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="fill_parent" />
    </LinearLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@id/seekbar_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/bar_height_status">
        <ImageView
            android:id="@id/portion_prev"
            android:tag="@string/previous"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="fill_parent"
            android:layout_alignParentLeft="true" />
        <com.mixplorer.widgets.MiSeekBar
            android:textSize="@dimen/title_text_size"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/portion_seek_bar"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toLeftOf="@id/portion_next"
            android:layout_toRightOf="@id/portion_prev" />
        <TextView
            android:textSize="@dimen/title_text_size"
            android:gravity="center_vertical"
            android:layout_gravity="end|center"
            android:id="@id/loaded_percent"
            android:layout_width="@dimen/size_40"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/size_10"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toRightOf="@id/portion_prev" />
        <ImageView
            android:id="@id/portion_next"
            android:tag="@string/next"
            android:layout_width="@dimen/bar_button_width"
            android:layout_height="fill_parent"
            android:layout_alignParentRight="true" />
    </RelativeLayout>
</LinearLayout>