<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/dialog_header" />
    <LinearLayout
        android:id="@id/body_view"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.mixplorer.widgets.MiScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/size_5"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/dialog_search_row_height">
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/search_align"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/WidgetSpinner" />
                    <com.mixplorer.widgets.MiEditText
                        android:id="@id/input_text"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_10"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1.0"
                        android:inputType="textFilter|textNoSuggestions"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        style="@style/EditText.WidgetEditText" />
                </LinearLayout>
                <TextView
                    android:id="@id/options"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    style="@style/DialogLeft" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/container"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/category_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dialog_search_row_height"
                        android:layout_marginTop="@dimen/size_5">
                        <TextView
                            android:id="@id/category_text"
                            android:focusable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/DialogLeft" />
                        <com.mixplorer.widgets.MiCombo
                            android:gravity="center"
                            android:id="@id/category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/size_4"
                            style="@style/WidgetSpinner" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_10">
                        <CheckBox
                            android:id="@id/search_current_dir"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            style="@style/WidgetCompoundButton.CheckBox" />
                        <CheckBox
                            android:id="@id/file_contents"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            style="@style/WidgetCompoundButton.CheckBox" />
                        <CheckBox
                            android:id="@id/inside_archive"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            style="@style/WidgetCompoundButton.CheckBox" />
                        <CheckBox
                            android:id="@id/metadata"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            style="@style/WidgetCompoundButton.CheckBox" />
                        <CheckBox
                            android:id="@id/print"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            style="@style/WidgetCompoundButton.CheckBox" />
                        <CheckBox
                            android:id="@id/ignore_no_search"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            style="@style/WidgetCompoundButton.CheckBox" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/size_bigger_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dialog_search_row_height"
                        android:layout_marginTop="@dimen/size_5">
                        <TextView
                            android:id="@id/size_bigger_text"
                            android:focusable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/DialogLeft" />
                        <com.mixplorer.widgets.MiEditText
                            android:gravity="center"
                            android:id="@id/input_bigger"
                            android:layout_width="@dimen/unit_input_width"
                            android:layout_height="wrap_content"
                            android:selectAllOnFocus="true"
                            android:maxLength="4"
                            android:inputType="number"
                            android:imeOptions="actionSearch|flagNoExtractUi"
                            style="@style/EditText.WidgetEditText" />
                        <com.mixplorer.widgets.MiCombo
                            android:gravity="center"
                            android:id="@id/bigger_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/size_4"
                            style="@style/WidgetSpinner" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/size_smaller_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dialog_search_row_height">
                        <TextView
                            android:id="@id/size_smaller_text"
                            android:focusable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/DialogLeft" />
                        <com.mixplorer.widgets.MiEditText
                            android:gravity="center"
                            android:id="@id/input_smaller"
                            android:layout_width="@dimen/unit_input_width"
                            android:layout_height="wrap_content"
                            android:selectAllOnFocus="true"
                            android:maxLength="4"
                            android:inputType="number"
                            android:imeOptions="actionSearch|flagNoExtractUi"
                            style="@style/EditText.WidgetEditText" />
                        <com.mixplorer.widgets.MiCombo
                            android:gravity="center"
                            android:id="@id/smaller_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/size_4"
                            style="@style/WidgetSpinner" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/time_before_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dialog_search_row_height"
                        android:layout_marginTop="@dimen/size_10">
                        <TextView
                            android:id="@id/date_before_text"
                            android:focusable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/DialogLeft" />
                        <com.mixplorer.widgets.MiTextView
                            android:id="@id/input_before"
                            android:focusable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/WidgetSpinner" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dialog_search_row_height">
                        <TextView
                            android:id="@id/date_after_text"
                            android:focusable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/DialogLeft" />
                        <com.mixplorer.widgets.MiTextView
                            android:id="@id/input_after"
                            android:focusable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/WidgetSpinner" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.mixplorer.widgets.MiScrollView>
    </LinearLayout>
    <include
        layout="@layout/dialog_footer" />
</LinearLayout>