<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BlackTheme" parent="@style/WallpaperTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorBackgroundCacheHint">@android:color/black</item>
    </style>
    <style name="Button">
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">0.0dip</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">@dimen/size_75</item>
        <item name="android:layout_weight">1.0</item>
    </style>
    <style name="DefaultTheme" parent="@style/WallpaperTheme">
        <item name="android:windowBackground">@color/splash_screen</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorBackgroundCacheHint">@color/splash_screen</item>
    </style>
    <style name="Dialog">
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <style name="Dialog.NoAnimation" parent="@style/Dialog">
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>
    <style name="DialogButton" parent="@style/Button">
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">@dimen/size_15</item>
        <item name="android:paddingTop">11.0dip</item>
        <item name="android:paddingRight">@dimen/size_15</item>
        <item name="android:paddingBottom">11.0dip</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="DialogLeft">
        <item name="android:textSize">@dimen/primary_text_size</item>
        <item name="android:layout_marginRight">@dimen/size_5</item>
    </style>
    <style name="DialogRight">
        <item name="android:textSize">@dimen/medium_text_size</item>
        <item name="android:padding">@dimen/size_2</item>
    </style>
    <style name="EditText" />
    <style name="EditText.WidgetEditText" parent="@style/EditText">
        <item name="android:textSize">@dimen/primary_text_size</item>
        <item name="android:gravity">fill_horizontal|center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">flagNoExtractUi</item>
    </style>
    <style name="NoDisplayTheme">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="ProgressBar">
        <item name="android:layout_gravity">center</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="SeekBar">
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">@dimen/size_10</item>
        <item name="android:paddingTop">0.0dip</item>
        <item name="android:paddingRight">@dimen/size_10</item>
        <item name="android:paddingBottom">0.0dip</item>
        <item name="android:layout_margin">0.0dip</item>
        <item name="android:thumbOffset">@dimen/size_10</item>
        <item name="android:layout_centerVertical">true</item>
    </style>
    <style name="ThemeOverlay.Material3.HarmonizedColors" parent="" />
    <style name="ThemeOverlay.Material3.HarmonizedColors.Empty" parent="" />
    <style name="ThemeOverlay.Material3.PersonalizedColors" parent="" />
    <style name="WallpaperTheme" parent="@android:style/Theme.Wallpaper.NoTitleBar" />
    <style name="WidgetCompoundButton">
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:gravity">start|center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="WidgetCompoundButton.CheckBox" parent="@style/WidgetCompoundButton" />
    <style name="WidgetEditText.NoBorder" parent="@style/EditText.WidgetEditText">
        <item name="android:gravity">center|left|top</item>
        <item name="android:scrollbars">none</item>
        <item name="android:singleLine">false</item>
        <item name="android:capitalize">sentences</item>
        <item name="android:inputType">textCapSentences|textImeMultiLine|textMultiLine</item>
    </style>
    <style name="WidgetSpinner">
        <item name="android:textSize">@dimen/primary_text_size</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
