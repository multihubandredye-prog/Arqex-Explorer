<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/content1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/top_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.mixplorer.widgets.MiToggleView
            android:id="@id/toggle"
            android:tag="@string/exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/title"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:maxLines="2"
            android:layout_weight="1.0" />
    </LinearLayout>
    <com.mixplorer.widgets.MiScrollView
        android:id="@id/main_page"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/size_5"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/size_15"
                android:paddingTop="@dimen/size_15"
                android:paddingRight="@dimen/size_15"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:id="@id/accounts_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="0.0dip" />
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/accounts"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="0.0dip"
                        android:minWidth="@dimen/min_list_width"
                        style="@style/WidgetSpinner" />
                </LinearLayout>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@id/add_account"
                    android:paddingLeft="@dimen/size_15"
                    android:paddingRight="@dimen/size_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15"
                android:baselineAligned="false">
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/port"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_15"
                    android:layout_marginRight="@dimen/size_15"
                    android:selectAllOnFocus="true"
                    android:maxLength="5"
                    android:layout_weight="2.0"
                    android:inputType="number"
                    style="@style/EditText.WidgetEditText" />
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/timeout"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_15"
                    android:layout_marginRight="@dimen/size_15"
                    android:selectAllOnFocus="true"
                    android:maxLength="6"
                    android:layout_weight="2.0"
                    android:inputType="number"
                    style="@style/EditText.WidgetEditText" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15"
                android:baselineAligned="false">
                <com.mixplorer.widgets.MiCombo
                    android:id="@id/ip"
                    android:focusable="true"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_15"
                    android:layout_marginTop="@dimen/size_5"
                    android:layout_marginRight="@dimen/size_15"
                    android:layout_weight="2.0"
                    style="@style/WidgetSpinner" />
                <CheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@id/start_on_boot"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_15"
                    android:layout_marginTop="@dimen/size_5"
                    android:layout_marginRight="@dimen/size_15"
                    android:layout_weight="2.0"
                    style="@style/WidgetCompoundButton.CheckBox" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/pasv_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15"
                android:baselineAligned="false">
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/pasv_ip"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_15"
                    android:layout_marginRight="@dimen/size_15"
                    android:selectAllOnFocus="true"
                    android:layout_weight="2.0"
                    android:inputType="textNoSuggestions"
                    style="@style/EditText.WidgetEditText" />
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/pasv_port"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_15"
                    android:layout_marginRight="@dimen/size_15"
                    android:selectAllOnFocus="true"
                    android:maxLength="5"
                    android:layout_weight="2.0"
                    android:inputType="number"
                    style="@style/EditText.WidgetEditText" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15"
                android:baselineAligned="false">
                <CheckBox
                    android:id="@id/tls"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_10"
                    android:layout_marginRight="@dimen/size_5"
                    android:layout_weight="2.0"
                    style="@style/WidgetCompoundButton.CheckBox" />
                <CheckBox
                    android:id="@id/tls13"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_5"
                    android:layout_marginRight="@dimen/size_5"
                    android:layout_weight="2.0"
                    style="@style/WidgetCompoundButton.CheckBox" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.0">
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/auth"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="0.0dip"
                        style="@style/WidgetSpinner" />
                    <com.mixplorer.widgets.MiCombo
                        android:id="@id/ssl_mode"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="0.0dip"
                        style="@style/WidgetSpinner" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_15"
                android:baselineAligned="false">
                <CheckBox
                    android:id="@id/qr_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_10"
                    android:layout_marginRight="@dimen/size_5"
                    style="@style/WidgetCompoundButton.CheckBox" />
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@id/add_shortcut"
                    android:paddingLeft="@dimen/size_15"
                    android:paddingRight="@dimen/size_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <com.mixplorer.widgets.MiEditText
                android:id="@id/index_page"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/size_15"
                android:layout_marginRight="@dimen/size_15"
                style="@style/EditText.WidgetEditText" />
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="@dimen/size_25"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@id/custom_key"
                    android:paddingLeft="@dimen/size_25"
                    android:paddingRight="@dimen/size_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/size_25"
                    android:paddingEnd="@dimen/size_15" />
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@id/certificate"
                    android:paddingLeft="@dimen/size_15"
                    android:paddingRight="@dimen/size_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <com.mixplorer.widgets.MiButton
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@id/stop_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_25"
                style="@style/DialogButton" />
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@id/img_qr"
                android:background="@android:color/transparent"
                android:layout_width="@dimen/ntf_expanded_thumb"
                android:layout_height="@dimen/ntf_expanded_thumb"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </com.mixplorer.widgets.MiScrollView>
</LinearLayout>