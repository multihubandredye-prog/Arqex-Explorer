<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_gravity="center"
    android:id="@id/content1"
    android:background="@android:color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/top_bar"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:background="#b3000000"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/toggle_width">
            <com.mixplorer.widgets.MiToggleView
                android:id="@id/toggle"
                android:tag="@string/exit"
                android:layout_width="@dimen/bar_button_width"
                android:layout_height="@dimen/bar_button_width" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="@dimen/size_5"
                android:paddingRight="@dimen/size_5"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0">
                <TextView
                    android:ellipsize="end"
                    android:gravity="left"
                    android:layout_gravity="center_vertical"
                    android:id="@id/bar_title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true" />
                <TextView
                    android:ellipsize="end"
                    android:gravity="left"
                    android:layout_gravity="bottom"
                    android:id="@id/bar_details"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>
            <com.mixplorer.widgets.MiImageView
                android:id="@id/overflow"
                android:tag="@string/menu"
                android:layout_width="@dimen/bar_button_width"
                android:layout_height="@dimen/bar_button_width" />
        </LinearLayout>
    </LinearLayout>
    <com.mixplorer.widgets.MiCircleView
        android:layout_gravity="center"
        android:id="@id/circle_view"
        style="@style/ProgressBar" />
    <include
        layout="@layout/bar_find" />
</FrameLayout>