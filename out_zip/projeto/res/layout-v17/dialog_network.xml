<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/dialog_header" />
    <LinearLayout
        android:id="@id/body_view"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.mixplorer.widgets.MiScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/size_5"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr">
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/network_server"
                    android:nextFocusDown="@id/network_search_local"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_5"
                    android:layout_marginBottom="@dimen/size_5"
                    android:inputType="textNoSuggestions"
                    android:textDirection="ltr"
                    android:layoutDirection="ltr"
                    style="@style/EditText.WidgetEditText" />
                <TextView
                    android:textSize="@dimen/medium_text_size"
                    android:id="@id/network_search_local"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusDown="@id/network_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_5" />
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/network_username"
                    android:nextFocusDown="@id/network_password"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_5"
                    android:layout_marginBottom="@dimen/size_5"
                    android:textDirection="ltr"
                    android:layoutDirection="ltr"
                    style="@style/EditText.WidgetEditText" />
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/network_password"
                    android:nextFocusDown="@id/network_display_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_5"
                    android:layout_marginBottom="@dimen/size_5"
                    android:inputType="textNoSuggestions|textPassword"
                    android:textDirection="ltr"
                    android:layoutDirection="ltr"
                    style="@style/EditText.WidgetEditText" />
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/network_display_name"
                    android:nextFocusDown="@id/network_advanced"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_5"
                    android:layout_marginBottom="@dimen/size_5"
                    android:inputType="textCapWords"
                    style="@style/EditText.WidgetEditText" />
                <com.mixplorer.widgets.MiEditText
                    android:id="@id/network_advanced"
                    android:nextFocusDown="@id/ok"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_5"
                    android:layout_marginBottom="@dimen/size_5"
                    android:minLines="2"
                    android:singleLine="false"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:textDirection="ltr"
                    android:layoutDirection="ltr"
                    style="@style/EditText.WidgetEditText" />
                <CheckBox
                    android:id="@id/ch_optional_lock"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    android:layout_marginBottom="@dimen/size_5"
                    style="@style/WidgetCompoundButton.CheckBox" />
            </LinearLayout>
        </com.mixplorer.widgets.MiScrollView>
    </LinearLayout>
    <include
        layout="@layout/dialog_footer" />
</LinearLayout>