<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_view"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/dialog_header" />
    <LinearLayout
        android:id="@id/body_view"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.mixplorer.widgets.MiScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TableLayout
                android:paddingTop="@dimen/size_5"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:shrinkColumns="4">
                <TableRow>
                    <TextView
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="1" />
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:gravity="center"
                        android:id="@id/label_perm_owner"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="2" />
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:gravity="center"
                        android:id="@id/label_perm_group"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="3" />
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:gravity="center"
                        android:id="@id/label_perm_others"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="4" />
                </TableRow>
                <TableRow>
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:gravity="end|center"
                        android:layout_gravity="end|center"
                        android:id="@id/label_perm_read"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="1" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_user_r"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="2"
                        style="@style/WidgetCompoundButton.CheckBox" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_group_r"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="3"
                        style="@style/WidgetCompoundButton.CheckBox" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_all_r"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="4"
                        style="@style/WidgetCompoundButton.CheckBox" />
                </TableRow>
                <TableRow>
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:gravity="end|center"
                        android:layout_gravity="end|center"
                        android:id="@id/label_perm_write"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="1" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_user_w"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="2"
                        style="@style/WidgetCompoundButton.CheckBox" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_group_w"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="3"
                        style="@style/WidgetCompoundButton.CheckBox" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_all_w"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="4"
                        style="@style/WidgetCompoundButton.CheckBox" />
                </TableRow>
                <TableRow>
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:gravity="end|center"
                        android:layout_gravity="end|center"
                        android:id="@id/label_perm_exec"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="1" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_user_x"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="2"
                        style="@style/WidgetCompoundButton.CheckBox" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_group_x"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="3"
                        style="@style/WidgetCompoundButton.CheckBox" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_all_x"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="4"
                        style="@style/WidgetCompoundButton.CheckBox" />
                </TableRow>
                <TableRow>
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:layout_gravity="center"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="1" />
                    <TextView
                        android:textSize="@dimen/medium_text_size"
                        android:layout_gravity="center"
                        android:id="@id/label_perm_uid"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="2" />
                    <TextView
                        android:textSize="@dimen/medium_text_size"
                        android:layout_gravity="center"
                        android:id="@id/label_perm_gid"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="3" />
                    <TextView
                        android:textSize="@dimen/medium_text_size"
                        android:layout_gravity="center"
                        android:id="@id/label_perm_sticky"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="4" />
                </TableRow>
                <TableRow>
                    <TextView
                        android:textSize="@dimen/primary_text_size"
                        android:gravity="end"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:layout_column="1" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_sp_su"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="2"
                        style="@style/WidgetCompoundButton.CheckBox" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_sp_sg"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="3"
                        style="@style/WidgetCompoundButton.CheckBox" />
                    <CheckBox
                        android:layout_gravity="center"
                        android:id="@id/perm_sp_t"
                        android:layout_width="@dimen/permission_check_width"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="4"
                        style="@style/WidgetCompoundButton.CheckBox" />
                </TableRow>
                <TableRow>
                    <com.mixplorer.widgets.MiEditText
                        android:textSize="@dimen/primary_text_size"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/txt_octal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_column="2"
                        android:layout_span="1" />
                    <TextView
                        android:textSize="@dimen/title_text_size"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@id/txt_permission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_column="3"
                        android:layout_span="2" />
                </TableRow>
                <TableRow>
                    <CheckBox
                        android:id="@id/perm_recursive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_column="1"
                        android:layout_span="4"
                        style="@style/WidgetCompoundButton.CheckBox" />
                </TableRow>
            </TableLayout>
        </com.mixplorer.widgets.MiScrollView>
    </LinearLayout>
    <include
        layout="@layout/dialog_footer" />
</LinearLayout>