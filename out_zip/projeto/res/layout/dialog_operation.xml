<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/dialog_header" />
    <LinearLayout
        android:id="@id/body_view"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.mixplorer.widgets.MiScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/size_5"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/operation_progress_box"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@id/operation_descr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:layout_toLeftOf="@id/operation_time"
                            android:layout_alignParentLeft="true"
                            style="@style/DialogLeft" />
                        <TextView
                            android:textSize="@dimen/medium_text_size"
                            android:gravity="right"
                            android:id="@id/operation_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:layout_alignParentRight="true" />
                    </RelativeLayout>
                    <TextView
                        android:ellipsize="start"
                        android:id="@id/operation_current"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_10"
                        android:maxLines="1"
                        android:singleLine="true"
                        style="@style/DialogLeft" />
                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_5">
                        <com.mixplorer.widgets.MiPlayPauseView
                            android:id="@id/operation_pause"
                            android:layout_width="@dimen/size_35"
                            android:layout_height="@dimen/size_35"
                            android:layout_marginRight="@dimen/size_10"
                            android:layout_alignParentLeft="true" />
                        <com.mixplorer.widgets.MiProgressBar
                            android:id="@id/operation_progress_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/progress_bar_height"
                            android:layout_toRightOf="@id/operation_pause"
                            android:layout_alignParentRight="true"
                            android:layout_alignWithParentIfMissing="true" />
                        <TextView
                            android:textSize="@dimen/secondary_text_size"
                            android:id="@id/operation_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@id/operation_pause"
                            android:layout_below="@id/operation_progress_bar" />
                        <TextView
                            android:textSize="@dimen/secondary_text_size"
                            android:gravity="right"
                            android:id="@id/operation_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/operation_progress_bar"
                            android:layout_alignParentRight="true" />
                    </RelativeLayout>
                    <TextView
                        android:id="@id/options"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_10"
                        style="@style/DialogLeft" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/container"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@id/from_row"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@id/operation_from_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/DialogLeft" />
                            <TextView
                                android:textSize="@dimen/medium_text_size"
                                android:id="@id/operation_from"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@id/to_row"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@id/operation_to_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/DialogLeft" />
                            <TextView
                                android:textSize="@dimen/medium_text_size"
                                android:id="@id/operation_to"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <com.mixplorer.widgets.MiCircleView
                    android:id="@id/loading_progress"
                    android:visibility="visible"
                    style="@style/ProgressBar" />
            </LinearLayout>
        </com.mixplorer.widgets.MiScrollView>
    </LinearLayout>
    <include
        layout="@layout/dialog_footer" />
</LinearLayout>