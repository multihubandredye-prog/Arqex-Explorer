<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/dialog_header" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/body_view"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:gravity="center_horizontal"
            android:id="@id/txt_message"
            android:paddingLeft="@dimen/size_15"
            android:paddingRight="@dimen/size_15"
            android:focusable="false"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_3" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/extra_content"
            android:paddingLeft="@dimen/size_15"
            android:paddingRight="@dimen/size_15"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/extra_content2"
            android:paddingLeft="@dimen/size_15"
            android:paddingRight="@dimen/size_15"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:textSize="@dimen/primary_text_size"
            android:gravity="center|top"
            android:id="@id/dialog_empty_view"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_15"
            android:layout_marginRight="@dimen/size_15" />
        <com.mixplorer.widgets.MiDraggableListView
            android:id="@id/list_alert"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
        <com.mixplorer.widgets.MiCircleView
            android:id="@id/dialog_progress"
            android:visibility="gone"
            style="@style/ProgressBar" />
    </LinearLayout>
    <include
        layout="@layout/dialog_footer" />
</LinearLayout>