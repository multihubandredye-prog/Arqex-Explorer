<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/content1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/top_bar"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.mixplorer.widgets.MiToggleView
            android:id="@id/toggle"
            android:tag="@string/exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.mixplorer.widgets.MiSpinner
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/navigation"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/title"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:maxLines="2" />
        </com.mixplorer.widgets.MiSpinner>
        <com.mixplorer.widgets.MiImageView
            android:id="@id/undo"
            android:tag="@string/undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/redo"
            android:tag="@string/redo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/save"
            android:tag="@string/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.mixplorer.widgets.MiImageView
            android:id="@id/overflow"
            android:tag="@string/menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <com.mixplorer.widgets.MiViewPager
        android:layout_gravity="fill"
        android:id="@id/main_page"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0" />
    <com.mixplorer.widgets.MiHorizontalScrollView
        android:layout_gravity="fill"
        android:id="@id/key_bars"
        android:padding="0.0dip"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/key_bar1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_45" />
    </com.mixplorer.widgets.MiHorizontalScrollView>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@id/status_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/bar_height_status">
        <TextView
            android:textSize="@dimen/button_text_size"
            android:ellipsize="none"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/encoding"
            android:layout_width="57.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/size_1"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_alignParentLeft="true" />
        <TextView
            android:textSize="@dimen/button_text_size"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/details"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/size_5"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toLeftOf="@id/ins_ovr"
            android:layout_toRightOf="@id/encoding" />
        <TextView
            android:textSize="@dimen/button_text_size"
            android:ellipsize="none"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/ins_ovr"
            android:layout_width="40.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/size_5"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toLeftOf="@id/options" />
        <ImageView
            android:id="@id/options"
            android:tag="@string/view"
            android:layout_width="45.0dip"
            android:layout_height="fill_parent"
            android:layout_alignParentRight="true" />
    </RelativeLayout>
</LinearLayout>